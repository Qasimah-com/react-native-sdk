{
  "name": "@qasimha/react-native-sdk",
  "version": "0.1.0",
  "description": "React Native checkout module for Qasimha: presents a hosted checkout session in the system browser sheet, reports the outcome, and offers an instalment promo component.",
  "license": "MIT",
  "author": "Qasimha",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "android/build.gradle",
    "android/gradle.properties",
    "android/consumer-rules.pro",
    "android/src",
    "ios",
    "QasimhaCheckout.podspec",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "prepack": "npm run build"
  },
  "keywords": [
    "qasimha",
    "bnpl",
    "buy-now-pay-later",
    "instalments",
    "checkout",
    "react-native",
    "saudi-arabia"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-svg": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@eslint/js": "^9.20.0",
    "@react-native/babel-preset": "0.76.x",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "react": "18.3.1",
    "react-native": "0.76.x",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.20.0"
  }
}
